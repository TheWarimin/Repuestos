PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (Render o local)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/repuestos_db

# JWT
JWT_SECRET=cambiar_este_secreto_jwt_muy_largo_y_seguro
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# MercadoPago (modo sandbox)
MP_ACCESS_TOKEN=TEST-tu-access-token-mercadopago
MP_WEBHOOK_SECRET=tu_webhook_secret

# Admin seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@repuestos.cl
ADMIN_PASSWORD=Admin1234!
